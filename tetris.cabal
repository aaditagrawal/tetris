name:                tetris
version:             0.1.6
homepage:            https://github.com/samtay/tetris#readme
license:             BSD3
license-file:        LICENSE
author:              Sam Tay
maintainer:          sam.chong.tay@pm.me
copyright:           2022 Sam Tay
category:            Web
build-type:          Simple
extra-source-files:  README.md
                   , tools/benchmark.py
                   , tools/remote-benchmark.py
cabal-version:       >=1.10

library
  hs-source-dirs:      src
  exposed-modules:     Tetris
                     , UI.PickLevel
                     , UI.Game
                     , UI.FrameClock
                     , UI.GravityClock
                     , UI.Grid
                     , UI.Image
                     , UI.Ticker
  build-depends:       base >= 4.7 && < 5
                     , brick
                     , containers
                     , extra
                     , lens
                     , linear
                     , mtl
                     , random
                     , stm
                     , text
                     , transformers
                     , vector
                     , vty
                     , vty-crossplatform
  default-language:    Haskell2010

executable tetris
  hs-source-dirs:      app
  main-is:             Main.hs
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N1
  build-depends:       base >= 4.7 && < 5
                     , directory
                     , filepath
                     , optparse-applicative
                     , tetris
  default-language:    Haskell2010

source-repository head
  type:     git
  location: https://github.com/SamTay/tetris

test-suite regression
  type:               exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:            Main.hs
  ghc-options:        -Wall -threaded
  build-depends:      base >= 4.7 && < 5
                    , brick
                    , containers
                    , linear
                    , mtl
                    , text
                    , tetris
                    , vector
                    , vty
  default-language:   Haskell2010
